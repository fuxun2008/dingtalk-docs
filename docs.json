{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DingTalk Help Center",
  "description": "Official help center for DingTalk International — guides, API references, and tutorials.",
  "colors": {
    "primary": "#007fff",
    "light": "#3399ff",
    "dark": "#005fcc"
  },
  "appearance": {
    "default": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://help.dingtalk.io"
  },
  "fonts": {
    "family": "PingFang SC"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Guides",
            "pages": ["guides/overview"]
          }
        ]
      },
      {
        "language": "zh",
        "groups": [
          {
            "group": "快速开始",
            "pages": ["zh/index", "zh/quickstart"]
          },
          {
            "group": "指南",
            "pages": ["zh/guides/overview"]
          }
        ]
      },
      {
        "language": "ja",
        "groups": [
          {
            "group": "はじめに",
            "pages": ["ja/index", "ja/quickstart"]
          },
          {
            "group": "ガイド",
            "pages": ["ja/guides/overview"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "DingTalk",
        "href": "https://www.dingtalk.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/dingtalk"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://help.dingtalk.io"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search docs..."
  }
}
