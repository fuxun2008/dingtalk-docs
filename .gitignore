node_modules/
.next/
.DS_Store
.tmp-reports/
# Mintlify：构建产物 / 缓存忽略，但 Assistant.md（站点 AI 助手系统提示）需要进版本库才能在线上生效
.mintlify/*
!.mintlify/Assistant.md
*.log
.env
.env.local
.playwright-mcp/
.qoder/
docs-preview-*.png
.screenshots/
.claude/*
!.claude/commands/
!.claude/commands/**
# training：白名单 onboarder 培训材料（cheatsheet / checklist / guide / outline / product-assignment）
!.claude/training/
!.claude/training/**
# dingtalk_downloader：白名单脚本 + README + requirements，敏感产物（cookie / endpoint / 下载历史）继续忽略
!.claude/import/
.claude/import/*
!.claude/import/dingtalk_downloader/
.claude/import/dingtalk_downloader/*
!.claude/import/dingtalk_downloader/*.py
!.claude/import/dingtalk_downloader/README.md
!.claude/import/dingtalk_downloader/requirements.txt
tools/review/dist/
tools/review/*.tsbuildinfo
tools/review/.vite/

# Apple Numbers binary source files (语言同学词库源；只 commit 导出的 csv)
*.numbers

# audit / link-check 产物（每次跑都会重生成）
scripts/output/audit_mdx/
scripts/output/check_links/
scripts/output/fix_cross_lang/
scripts/output/emoji_tags/
scripts/output/polish_docs/
scripts/output/image_backfill/
scripts/output/security_scan/
scripts/output/open_desc/
# gen_descriptions：description AI 批量生成报告 + 运行日志,不入库
scripts/output/gen_descriptions/
# refetch-images：图片同步流水线中间产物（manifest / mapping / staging mdx / report），不入库
scripts/output/refetch-images/
# wrap_mobile：移动端截图 flex 包装中间产物（report / json），不入库
scripts/output/wrap_mobile/
# translate_docs：批量翻译 report 中间产物（每次跑都会重生成），不入库
scripts/output/translate_docs/
scripts/__pycache__/

# open.dingtalk.com 抓取产物：raw md / clean md / 中间 json 不入库，只保留 *.md 摘要追溯
scripts/output/open_platform/raw/
scripts/output/open_platform/clean/
scripts/output/open_platform/constraints/preview/
scripts/output/open_platform/constraints/changes.json
scripts/output/open_platform/*.json
scripts/output/open_platform/menu/
# 验收截图 ephemeral 不入库（.git 已 1.1 GB / PNG 累计 819 MB，详见 memory project_repo_size_decision）
scripts/output/open_platform/*.png
